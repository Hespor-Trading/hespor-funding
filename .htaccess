# HESPOR Funding — Hostinger (LiteSpeed/Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
# Old single-page URLs from the first version
Redirect 301 /privacy.html /privacy/
Redirect 301 /thank-you.html /thank-you/
# Persian pages were removed: send old /fa/ URLs to the English equivalents
RedirectMatch 301 ^/fa/(business-loans|merchant-cash-advance|line-of-credit|calculator|how-it-works|apply|faq|about|industries|privacy|thank-you)/?$ /$1/
RedirectMatch 301 ^/fa/(vancouver|toronto)/?$ /locations/$1/
RedirectMatch 301 ^/fa(/.*)?$ /
Redirect 301 /assets/css/styles.css /assets/css/site.css
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddDefaultCharset UTF-8
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript text/plain application/xml image/svg+xml application/manifest+json application/ld+json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
